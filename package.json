{
  "name": "@crysound/crychart",
  "version": "1.0.4",
  "description": "CRYChart chart engine with streaming data, interactive axes and WebGL rendering",
  "type": "module",
  "main": "./dist/crychart.cjs",
  "module": "./dist/crychart.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/crychart.js",
      "require": "./dist/crychart.cjs"
    },
    "./themes": {
      "types": "./dist/types/themes.d.ts",
      "import": "./dist/themes.js"
    }
  },
  "files": [
    "LICENSE.md",
    "LICENSE.zh-CN.md",
    "dist/crychart.js",
    "dist/crychart.cjs",
    "dist/crychart.global.js",
    "dist/themes.js",
    "dist/types",
    "README.md",
    "README.zh-CN.md",
    "docs/npm-usage.md"
  ],
  "scripts": {
    "prepack": "npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:opentest-contract",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:coverage": "c8 node scripts/test.mjs --coverage",
    "test:api": "node scripts/check-api-tests.mjs",
    "api:map:update": "node scripts/check-api-tests.mjs --update",
    "test:browser": "node scripts/browser-test.mjs",
    "test:gallery": "node scripts/test-gallery.mjs",
    "test:opentest-contract": "node scripts/test.mjs --opentest",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "node scripts/serve.mjs",
    "verify": "npm run typecheck && npm run test:coverage && npm run test:api && npm run build && npm run test:browser && npm run test:gallery"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "c8": "10.1.3",
    "esbuild": "0.25.12",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crysound/CRYChart.git"
  },
  "homepage": "https://github.com/crysound/CRYChart#readme",
  "bugs": {
    "url": "https://github.com/crysound/CRYChart/issues"
  }
}
