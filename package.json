{
  "name": "crychart",
  "version": "1.0.1-opentest.26",
  "description": "CRYChart chart engine with streaming data, interactive axes and WebGL rendering",
  "type": "module",
  "main": "./dist/crychart.cjs",
  "module": "./dist/crychart.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/crychart.js",
      "require": "./dist/crychart.cjs"
    },
    "./themes": {
      "types": "./dist/types/themes.d.ts",
      "import": "./dist/themes.js"
    }
  },
  "files": [
    "LICENSE.md",
    "LICENSE.zh-CN.md",
    "dist/crychart.js",
    "dist/crychart.cjs",
    "dist/crychart.global.js",
    "dist/themes.js",
    "dist/types",
    "README.md",
    "README.zh-CN.md",
    "docs/*.md",
    "docs/*.json",
    "docs/*.html",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:gallery": "node scripts/test-gallery.mjs",
    "test:opentest-contract": "node scripts/test.mjs --opentest",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "node scripts/serve.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:gallery"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.25.12",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
